@{
    Layout = "~/Views/Shared/_TestLayout.cshtml";
    ViewBag.Title = "Menü";
}

<style>
    #section-2 {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
    }

    .card {
        background-color: #f8f9fa;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        text-align: center;
        width: 300px;
    }

        .card img {
            width: 100%;
            height: 200px;
            border-bottom: 1px solid #ddd;
            object-fit: cover;
        }

    .container {
        padding: 15px;
    }

        .container h2 {
            font-size: 24px;
            margin: 10px 0;
        }

        .container p {
            font-size: 16px;
            color: #555;
        }

    .card a {
        text-decoration: none;
        color: inherit;
    }
</style>

<section id="section-2">
    <div class="card">
        <a href="@Url.Action("Hamburger", "Urun")">
            <img src="~/web-site/image/1353005.png" alt="HAMBURGER">
            <div class="container">
                <h2>Hamburgerler</h2>
                <p>Lezzetli hamburger seçenekleri</p>
            </div>
        </a>
    </div>
    <div class="card">
        <a href="@Url.Action("Pizza", "Urun")">
            <img src="~/web-site/image/PİZZA.jpg" alt="PİZZA">
            <div class="container">
                <h2>Pizzalar</h2>
                <p>Taze ve çeşitli pizza seçenekleri</p>
            </div>
        </a>
    </div>
    <div class="card">
        <a href="@Url.Action("Sushi", "Urun")">
            <img src="~/web-site/image/SUSHİ.jpg" alt="SUSHİ">
            <div class="container">
                <h2>Sushi</h2>
                <p>Lezzetli sushi türleri</p>
            </div>
        </a>
    </div>
    <div class="card">
        <a href="@Url.Action("Balık", "Urun")">
            <img src="~/web-site/image/BALIK.jpg" alt="BALIK">
            <div class="container">
                <h2>Balık</h2>
                <p>Taze deniz ürünleri ve balık çeşitleri</p>
            </div>
        </a>
    </div>
    <div class="card">
        <a href="@Url.Action("İçecekler", "Urun")">
            <img src="~/web-site/image/drinks.jpg" alt="İÇECEKLER">
            <div class="container">
                <h2>İçecekler</h2>
                <p>Serinletici içecekler</p>
            </div>
        </a>
    </div>
    <div class="card">
        <a href="@Url.Action("Tatlı", "Urun")">
            <img src="~/web-site/image/TATLI.jpg" alt="TATLI">
            <div class="container">
                <h2>Tatlı</h2>
                <p>Tatlı keyfi için özel seçenekler</p>
            </div>
        </a>
    </div>
</section>
