@{
    Layout = null;
}

@model IEnumerable<YemekUygulaması.Models.Balık>

@{
    ViewBag.Title = "Balık Seçenekleri";
}

<style>
    .container {
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
        overflow: hidden;
    }

    .balık-list {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center; /* Kartları ortalamak için */
    }

    .balık-item {
        background-color: #ffffff; /* Beyaz arka plan */
        border-radius: 15px; /* Köşeleri yuvarlatılmış */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        padding: 20px;
        width: 300px; /* Kart genişliği */
        text-align: center;
        border: 1px solid #e0e0e0; /* Hafif gri sınır */
        box-sizing: border-box; /* Padding ve border genişlikten çıkarılmaz */
    }

        .balık-item img {
            max-width: 100%; /* Resmin genişliğini kapsayıcıya göre ayarlar */
            height: auto; /* Yüksekliği orantılı olarak ayarlar */
            max-height: 200px; /* Maksimum yükseklik sınırı */
            object-fit: cover; /* Resimlerin sığdırılması için */
            border-radius: 15px;
        }

        .balık-item h2 {
            font-size: 24px;
            margin-top: 15px;
            color: #333; /* Koyu gri renk */
        }

        .balık-item p {
            font-size: 16px;
            margin: 10px 0;
            color: #666; /* Orta gri renk */
        }

    .add-button {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 10px 20px;
        font-size: 16px;
        border-radius: 5px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

        .add-button:hover {
            background-color: #218838;
        }

    .btn-primary {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 10px 20px;
        font-size: 16px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }
</style>

<section>
    <div class="container">
        <div class="balık-list">
            @foreach (var balık in Model)
            {
                var resimUrl = balık.ResimURL;
                <div class="balık-item">
                    <h2>@balık.Adı</h2>

                    @if (!string.IsNullOrEmpty(resimUrl))
                    {
                        <img src="@resimUrl" alt="Balık Resmi" />
                    }
                    else
                    {
                        <img src="~/web-site/image/default.jpg" alt="Varsayılan Resim" />
                    }

                    <p>@balık.Açıklama</p>
                    <p><strong>Fiyat:</strong> @balık.Fiyat.ToString()</p>
                    @using (Html.BeginForm("AddToCart", "Sepet", FormMethod.Post))
                    {
                        @Html.Hidden("itemId", balık.ID)
                        @Html.Hidden("itemType", "Balık")
                        <button type="submit" class="add-button">Ekle</button>
                    }
                </div>
            }
        </div>
        <a href="@Url.Action("Index", "Default")" class="btn btn-primary">Geri Dön</a>
    </div>
</section>
