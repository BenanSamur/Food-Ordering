@{
    Layout = null;
}

@model IEnumerable<YemekUygulaması.Models.Tatlı>

@{

    ViewBag.Title = "Tatlı Seçenekleri";
}

<style>
    .container {
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
        overflow: hidden;
    }

    .tatlı-list {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
    }

    .tatlı-item {
        background-color: #ffffff;
        border-radius: 15px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        padding: 20px;
        width: 300px;
        text-align: center;
        border: 1px solid #e0e0e0;
        box-sizing: border-box;
    }

        .tatlı-item img {
            max-width: 100%;
            height: auto;
            max-height: 200px;
            object-fit: cover;
            border-radius: 15px;
        }

        .tatlı-item h2 {
            font-size: 24px;
            margin-top: 15px;
            color: #333;
        }

        .tatlı-item p {
            font-size: 16px;
            margin: 10px 0;
            color: #666;
        }

    .add-button {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 10px 20px;
        font-size: 16px;
        border-radius: 5px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

        .add-button:hover {
            background-color: #218838;
        }

    .btn-primary {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 10px 20px;
        font-size: 16px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }
</style>

<section>
    <div class="container">
        <div class="tatlı-list">
            @foreach (var tatlı in Model)
            {
                var resimUrl = tatlı.ResimURL;
                <div class="tatlı-item">
                    <h2>@tatlı.Adı</h2>

                    @if (!string.IsNullOrEmpty(resimUrl))
                    {
                        <img src="@resimUrl" alt="Tatlı Resmi" />
                    }
                    else
                    {
                        <img src="~/web-site/image/default.jpg" alt="Varsayılan Resim" />
                    }

                    <p>@tatlı.Açıklama</p>
                    <p><strong>Fiyat:</strong> @tatlı.Fiyat.ToString()</p>
                    @using (Html.BeginForm("AddToCart", "Sepet", FormMethod.Post))
                    {
                        @Html.Hidden("itemId", tatlı.ID)
                        @Html.Hidden("itemType", "Tatlı")
                        <button type="submit" class="add-button">Ekle</button>
                    }
                </div>
            }
        </div>
        <a href="@Url.Action("Index", "Default")" class="btn btn-primary">Geri Dön</a>
    </div>
</section>
