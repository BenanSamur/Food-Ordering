@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        * {
            padding: 0;
            margin: 0;
            box-sizing: border-box;
        }

        header {
            background-color: palevioletred;
            padding: 20px 25px;
        }

        nav {
            display: inline-block;
            width: calc(100% - 103px);
            text-align: right;
        }

            nav ul {
                list-style-type: none;
            }

                nav ul li {
                    display: inline-block;
                    margin: 10px 25px;
                    position: relative;
                }

        .logo {
            color: white;
            text-decoration: none;
            font-weight: bold;
            font-size: 22px;
        }

            .logo img {
                max-height: 60px;
                width: auto;
            }

        nav ul li a {
            text-decoration: none;
            color: #fff;
            padding: 15px 25px;
            font-size: 22px;
        }

            nav ul li a:hover {
                background-color: #fff;
                color: #000;
            }

        .dropdown-menu {
            display: none;
            position: absolute;
            background-color: #fff;
            color: #000;
            min-width: 200px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            z-index: 1;
            top: 100%;
            left: 0;
            border-radius: 6px;
            padding: 10px 0;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

            .dropdown-menu a {
                color: black;
                padding: 12px 20px;
                text-decoration: none;
                display: block;
                border-bottom: 1px solid #ddd;
            }

                .dropdown-menu a:hover {
                    background-color: #eee;
                }

        .dropdown:hover .dropdown-menu {
            display: block;
            opacity: 1;
            visibility: visible;
        }

        #section-1 {
            background-image: url(/web-site/image/view-healthy-food-incased-pill-shaped-container.jpg);
            background-position: top;
            padding: 12px;
            height: 850px;
            width: 100%;
            background-size: cover;
        }

        .btn-s1 {
            margin-left: 45%;
            margin-top: 20%;
            background-color: #E94560;
            color: #fff;
            padding: 25px 20px;
            font-size: 20px;
            border-radius: 6px;
            transition: color 1s;
        }

            .btn-s1:hover {
                color: black;
            }

        #section-2 {
            display: flex;
            justify-content: space-around;
            margin: 200px 0;
        }

        .card {
            width: 250px;
            height: 300px;
            box-shadow: 0 5px 9px 0 rgba(0, 0, 0, 0.1);
            border-radius: 6px;
            background-color: #E94560;
            background-size: cover;
            overflow: hidden;
            margin-bottom: 30px;
        }

            .card:hover {
                opacity: 0.7;
            }

        .container {
            padding: 5px 20px;
            height: 200px;
        }

            .container h2 {
                font-family: 'Roboto', sans-serif;
                font-size: 27px;
                margin-bottom: 10px;
            }

            .container p {
                margin: 5px 0;
                font-family: sans-serif;
            }

        img {
            border-radius: 6px 6px 0 0;
            width: 100%;
        }

        #section-3 {
            display: flex;
            justify-content: space-around;
            margin: 200px 0;
            height: 200px;
        }

        footer {
            background-color: palevioletred;
            color: white;
            text-align: center;
            font-size: 20px;
            padding: 20px 0;
        }

        ion-icon {
            font-size: 24px; /* Increase icon size */
            vertical-align: middle; /* Align icon vertically */
            margin-left: 5px; /* Add some space between text and icon */
        }
    </style>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</head>
<body>
    <header>
        <a href="#" class="logo">
            <img src="~/web-site/image/Untitled_logo_1_free-file.jpg" alt="Logo" />
        </a>
        <nav>
            <ul>
                <li><a href="/Default/Index">Anasayfa</a></li>
                <li><a href="/Default/Menü">Menü</a></li>
                <li><a href="/Default/İletişim">İletişim</a></li>
                <li><a href="/Default/Register">Kayıt Ol</a></li>
                <li class="dropdown">
                    <a href="#">Giriş</a>
                    <div class="dropdown-menu">
                        <a class="dropdown-item" href="/Default/Giriş">Kullanıcı</a>
                        <a class="dropdown-item" href="/Default/AdminLogin">Admin</a>
                    </div>
                </li>
                <li><a href="/Sepet/Index"><ion-icon name="basket-outline"></ion-icon><span id="basket-count">0</span></a></li>
            </ul>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        powered by Benan Samur
    </footer>
    <script>
        $(document).ready(function() {
            function updateBasketIcon() {
                $.get('@Url.Action("GetBasketCount", "Sepet")', function(response) {
                    if (response.success) {
                        $('#basket-count').text(response.count);
                    }
                });
            }

            // Handle "Add to Cart" button clicks
            $('.add-button').on('click', function(event) {
                event.preventDefault();
                var form = $(this).closest('form');
                var actionUrl = form.attr('action');
                $.post(actionUrl, form.serialize(), function(response) {
                    if (response.success) {
                        updateBasketIcon();
                        window.location.href = '/Sepet/Index'; // Redirect
                    }
                });
            });

            // Redirect to AdminLogin page when Admin link is clicked
            $('#admin-login').on('click', function(event) {
                event.preventDefault();
                window.location.href = '/Default/AdminLogin';
            });

            updateBasketIcon();
        });
    </script>
</body>
</html>